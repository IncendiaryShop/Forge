# Copy this file to .env.local and fill in your Supabase project's values.
# Find these in your Supabase project: Settings -> API.
#
# VITE_SUPABASE_PUBLISHABLE_KEY is the "anon" / "publishable" key — safe to
# expose in a browser bundle. NEVER put the service_role key here or anywhere
# in frontend code; it bypasses Row Level Security entirely.

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
